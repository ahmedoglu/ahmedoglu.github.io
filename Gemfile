source "https://rubygems.org"

# GitHub Pages builds this site with the exact versions pinned by the
# github-pages gem. Using the same gem locally keeps previews identical
# to the live site. Preview with:  bundle exec jekyll serve
gem "github-pages", group: :jekyll_plugins

# Required by `jekyll serve` on Ruby 3 and newer.
gem "webrick", "~> 1.8"
